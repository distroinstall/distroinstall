generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// BORRA la tabla "users" del template y pon tu estructura:

model Submission {
  id              String   @id @default(cuid())
  token           String?  // QUITAR @unique de aquí
  userId          String?
  distroName      String
  distroVersion   String
  kernel          String
  desktopEnv      String
  cpu             String
  cpuCores        Int
  cpuThreads      Int
  ram             Float
  gpu             String
  isVirtual       Boolean
  usageType       String
  timestamp       DateTime @default(now())
  
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([distroName])
  @@index([timestamp])
  @@index([token])  // Agregar índice para búsquedas rápidas
  @@index([userId])
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String?
  username        String?      @unique
  image           String?
  submissions     Submission[]
  badges          Badge[]
  createdAt       DateTime     @default(now())
}

model Badge {
  id              String   @id @default(cuid())
  userId          String
  badgeType       String
  earnedAt        DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, badgeType])
}