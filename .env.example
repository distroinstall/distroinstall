# ── Database (PostgreSQL / Neon) ──────────────────────────────
# Use a SEPARATE database for local development (never the production one).
# Pooled connection string (used by Prisma at runtime):
POSTGRES_PRISMA_URL=
# Direct connection string (used by `prisma db push` / migrations):
POSTGRES_URL_NON_POOLING=

# ── NextAuth ──────────────────────────────────────────────────
# App URL. Local: http://localhost:3000 — Production: https://distroinstall.com
NEXTAUTH_URL=http://localhost:3000
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── OAuth providers ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ── Email (Resend) ────────────────────────────────────────────
# API key from https://resend.com (starts with re_)
# Sender domain must be verified in Resend (we send from noreply@distroinstall.com)
RESEND_API_KEY=
